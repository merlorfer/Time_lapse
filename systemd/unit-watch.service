[Unit]
Description=CLCode01 / WiFiGateway unit error watcher (error journal + email alerts)
After=network.target

[Service]
Type=simple
User=orangepi
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/orangepi/timelapse/scripts/unit_watch.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
