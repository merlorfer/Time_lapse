[Unit]
Description=Multi-source sensor data collector (UART + WiFi gateway units)
After=network.target

[Service]
Type=simple
User=orangepi
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/orangepi/timelapse/scripts/sensor_collector.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
