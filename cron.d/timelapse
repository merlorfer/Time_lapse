# /etc/cron.d/timelapse – Timelapse rendszer ütemezés
# Telepítés: sudo cp timelapse /etc/cron.d/ && sudo chmod 644 /etc/cron.d/timelapse
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
TZ=Europe/Budapest

# Képrögzítés: percenként (az időablakot capture.sh kezeli belülről: 06:00–20:00)
* * * * * orangepi /home/orangepi/timelapse/scripts/capture.sh

# Videó összefűzés: percenként ellenőrzi, és a rögzítési ablak vége után 1 perccel összefűzi a
# munkamenet képeit (éjfélen átnyúló ablaknál is; a videó neve az ablak kezdő napja).
# A képek addig a ramdisken maradnak, és csak a sikeres mentés után törlődnek.
* * * * * orangepi /home/orangepi/timelapse/scripts/compile_check.sh

# Szenzor adatok napi mentése ramdiskről (a videótól független)
5 0 * * * orangepi /home/orangepi/timelapse/scripts/sensor_backup.sh >> /home/orangepi/timelapse/logs/compile.log 2>&1

# Ütemezett reboot ellenőrzés: óránként (a reboot időpontja a timelapse_config.json-ban állítható)
0 * * * * orangepi /home/orangepi/timelapse/scripts/check_scheduled_reboot.sh
